library(clusterProfiler)
library(org.Hs.eg.db)
# Map your genes to GO terms
go_annot <- AnnotationDbi::select(org.Hs.eg.db, keys = your_genes, columns = "GO", keytype = "SYMBOL")
# Map your genes to GO terms
go_annot <- AnnotationDbi::select(org.Hs.eg.db, keys = erbb_genes, columns = "GO", keytype = "SYMBOL")
# Find genes with receptor or ligand activity
receptor_genes <- unique(go_annot$SYMBOL[go_annot$GO %in% c("GO:0004872", "GO:0004888")]) # receptor activity
ligand_genes <- unique(go_annot$SYMBOL[go_annot$GO %in% c("GO:0048018", "GO:0005102")])   # ligand activity
binding_genes <- unique(go_annot$SYMBOL[go_annot$GO == "GO:0005515"])                     # protein binding
# Assign type
node_types <- setNames(rep("other", length(erbb_genes)), erbb_genes)
node_types[receptor_genes] <- "receptor"
node_types[ligand_genes] <- "ligand"
node_types[binding_genes] <- "binding protein"
node_types
# Assign type
node_types <- setNames(rep("other", length(erbb_genes)), erbb_genes)
node_types[receptor_genes] <- "receptor"
receptor_genes
ligand_genes
binding_genes
node_types[receptor_genes] <- "receptor"
node_types[ligand_genes] <- "ligand"
node_types[binding_genes] <- "binding protein"
test_df = node_types
test_df = as.data.frame(node_types)
View(test_df)
node_types[ligand_genes] <- "ligand"
node_types[receptor_genes] <- "receptor"
test_df = as.data.frame(node_types)
for (mod in names(genes_by_module)) {
genes <- genes_by_module[[mod]]
g <- induced_subgraph(erbb_big_network$igraph_object, vids = genes)
# Precompute layout for this module (e.g., Fruchterman-Reingold)
layout_mat <- layout_with_kk(g)
layout_df <- as.data.frame(layout_mat)
colnames(layout_df) <- c("x", "y")
layout_df$name <- V(g)$name
for (st in colnames(mean_expr_by_subtype)) {
expr_vals <- mean_expr_by_subtype[genes, st]
V(g)$mean_expr <- expr_vals[V(g)$name]
V(g)$type <- node_types[V(g)$name]
subtype_range <- range(expr_vals, na.rm = TRUE)
# Use the precomputed layout
p <- ggraph(g, layout = "manual", x = layout_df$x, y = layout_df$y) +
geom_edge_link(color = "black", alpha = 1, width = 0.3) +
geom_node_point(aes(color = mean_expr, shape = type), size = 20, show.legend = FALSE) +
scale_shape_manual(values = c("binding protein" = 21, "ligand" = 22, "receptor" = 24)) +
scale_color_gradientn(
colors = c("#4DF76F", "black", "#F74D4D"),
values = scales::rescale(c(subtype_range[1], 0, subtype_range[2])),
limits = subtype_range,
na.value = "grey80",
name = "Mean Expr"
) +
geom_label(aes(x = x, y = y, label = name), fill = "white", color = "black", size = 4, fontface = "bold", label.size = 0.2) +
theme_bw(base_size = 15) +
theme(
axis.title.x = element_blank(),
axis.title.y = element_blank(),
axis.text.x = element_blank(),
axis.text.y = element_blank(),
panel.grid = element_blank(),
axis.ticks = element_blank(),
plot.title.position = "plot",
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5)
) +
labs(title = paste("Module", mod, "-", st))
CairoPDF(paste0("analysis_sets/ERBB/figures/big_network/module_ppi/module_", mod, "_", st, ".pdf"), width = 8, height = 6)
print(p)
dev.off()
}
}
